{
  "lexicon": 1,
  "id": "app.skydrops.bats.card",
  "defs": {
    "main": {
      "type": "record",
      "description": "A single B.A.T.S. game card (Black or White).",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["text", "type", "createdAt"],
        "properties": {
          "text": { 
            "type": "string", 
            "description": "The horrible text on the card.",
            "maxGraphemes": 300 
          },
          "type": { 
            "type": "string", 
            "knownValues": ["prompt", "response"],
            "description": "Prompt (Black) or Response (White)." 
          },
          "authorDid": { 
            "type": "string", 
            "format": "did",
            "description": "The DID of the devious mind who wrote this." 
          },
          "createdAt": { 
            "type": "string", 
            "format": "datetime" 
          }
        }
      }
    }
  }
}
